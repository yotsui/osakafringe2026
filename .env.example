# ==============================================================================
# Osaka Fringe 2026 - Environment Variables Example Template
# Copy this file to .env.local and fill in your actual API credentials.
# Note: If credentials are not set, the app runs with internal realistic mock data.
# ==============================================================================

# microCMS Configuration (Server-side only)
# Domain subdomain: e.g. "osakafringe" for "https://osakafringe.microcms.io"
MICROCMS_SERVICE_DOMAIN=your_microcms_service_domain
MICROCMS_API_KEY=your_microcms_api_key

# Google Gemini API Configuration (Used ONLY for local CLI script: npm run translate:backfill)
# Not required in production / Vercel deployment.
GEMINI_API_KEY=your_gemini_api_key

# Stripe Payment / Donation Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Public Site URL (Used for verified canonical redirects & OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Site Protection & microCMS Draft Preview Configuration
# ==============================================================================
# 全体サイトパスワード保護（公開前の検証環境用）
# 'true' に設定するとサイト全体にパスワード認証が要求され、X-Robots-Tag (noindex) が付与されます。
# ※本番環境で一般公開する場合は必ず 'false' にしてください。
TEST_SITE_PROTECTION_ENABLED=false

# microCMS 公演下書きプレビュー機能
# 'true' に設定すると /preview/performances/[id]?draftKey=... が有効になります。
# 未設定または 'false' の場合はプレビューURLは 404 Not Found を返します。
# 本番環境（一般公開）でも 'true' に設定することで、通常ページは一般公開のまま
# 下書きプレビューのみをパスワード保護下で安全に利用できます。
MICROCMS_PREVIEW_ENABLED=false

# 認証パスワード（全体保護またはプレビュー利用時に必須）
# プレビューを有効化する場合、このパスワードの明示設定が必須です。
TEST_SITE_PASSWORD=your_secure_preview_or_test_password

# セッション署名用シークレット（HMAC-SHA256、全体保護またはプレビュー利用時に必須）
# プレビューを有効化する場合、32文字以上のランダムな秘密鍵の明示設定が必須です（代用不可）。
TEST_SITE_AUTH_SECRET=your_random_32_character_secret_key